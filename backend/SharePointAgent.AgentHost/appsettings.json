{
  "Monitoring": {
    "OpenTelemetry": {
      "Exporter": "Otlp"
    }
  },
  "ContentSafety": {
    "Enabled": false,
    "Endpoint": "",
    "ApiKey": "",
    "UseManagedIdentity": true,
    "ManagedIdentityClientId": null,
    "TimeoutSeconds": 15,
    "HateThreshold": 4,
    "SexualThreshold": 4,
    "ViolenceThreshold": 4,
    "SelfHarmThreshold": 4
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SqlServer": {
    "ConnectionString": "",
    "AutoMigrate": false,
    "CommandTimeoutSeconds": 30
  },
  "SharePoint": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "SiteHostname": "",
    "SitePath": "",
    "DocumentLibraryName": "Documents"
  },
  "AzureSearch": {
    "UsedManagedIdentity": true,
    "Endpoint": "",
    "SharePointIndexName": "sharepoint-files",
    "UploadIndexName": "chat-uploads",
    "VectorDimensions": 1536
  },
  "AzureOpenAI": {
    "UsedManagedIdentity": true,
    "Endpoint": "",
    "EmbeddingDeployment": "text-embedding-3-small",
    "ChatDeployment": "gpt-5-mini"
  },
  "Uploads": {
    "UsedManagedIdentity": true,
    "ServiceUri": "",
    "ContainerName": "chat-uploads"
  },
  "MarkItDown": {
    "Endpoint": "",
    "TimeoutSeconds": 120
  },
  "PageIndex": {
    "Endpoint": "",
    "ApiKey": null,
    "IndexPath": "/index",
    "HealthPath": "/health",
    "TimeoutSeconds": 360
  },
  "Ollaya": {
    "Endpoint": "",
    "ApiKey": null,
    "Model": "winnow:e4b",
    "DecidePath": "/v1/systemone",
    "HealthPath": "/",
    "TimeoutSeconds": 300
  },
  "LocalWorkingDirectory": {
    "Directory": "",
    "Downloads": {
      "MaxFileBytes": 20971520
    }
  },
  "GraphRag": {
    "IndexingEnabled": false,
    "RetrievalEnabled": false,
    "ShadowRetrieval": false,
    "EnabledTenantIds": [],
    "IndexingQueueName": "graph-indexing",
    "AliasIndexName": "graph-entity-aliases",
    "Extraction": {
      "Deployment": "",
      "IncludeEncryptedDocuments": false,
      "MaxConcurrentDocuments": 2,
      "MaxConcurrentChunks": 4,
      "MaxChunksPerDocument": 200,
      "MaxOutputTokens": 2000,
      "NeighborContextCharacters": 600,
      "MaxRetries": 4,
      "MaxDeliveryAttempts": 8
    },
    "Traversal": {
      "DefaultMaxDepth": 2,
      "MaxEntities": 50,
      "MaxAssertions": 200,
      "MaxSeedEntities": 10,
      "TimeoutMilliseconds": 1500,
      "MaxRequestCharge": 500,
      "MaxAdditionalChunks": 5,
      "MaxAdditionalCharacters": 12000,
      "MaxEvidenceDocuments": 40
    },
    "Reconciliation": {
      "Enabled": true,
      "IntervalMinutes": 60,
      "PageSize": 200,
      "MaxRepairsPerCycle": 500,
      "RetractedRetentionDays": 30
    },
    "Cosmos": {
      "UsedManagedIdentity": true,
      "Endpoint": "",
      "DatabaseName": "graphrag",
      "PartitionBuckets": 16,
      "CreateIfNotExists": false
    },
    "Archive": {
      "UsedManagedIdentity": true,
      "ServiceUri": "",
      "ContainerName": "graph-snapshots"
    }
  }
}
