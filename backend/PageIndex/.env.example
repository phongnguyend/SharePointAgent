# Copy to .env. Replace placeholders before enabling summaries.
# Generate the service key using the PowerShell script in README.md.
PAGEINDEX_SERVICE_API_KEY=replace-with-generated-service-key
PAGEINDEX_MAX_FILE_BYTES=26214400
PAGEINDEX_TIMEOUT_SECONDS=300
PAGEINDEX_MAX_CONCURRENCY=2

# Azure OpenAI: use your deployment name after azure/.
PAGEINDEX_INDEX_MODEL=azure/YOUR-DEPLOYMENT-NAME
AZURE_API_BASE=https://YOUR-RESOURCE.openai.azure.com/
AZURE_API_KEY=replace-with-azure-openai-key
AZURE_API_VERSION=YOUR-SUPPORTED-API-VERSION
