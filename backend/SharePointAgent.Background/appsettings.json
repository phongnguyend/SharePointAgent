{
  "Monitoring": {
    "OpenTelemetry": {
      "Exporter": "Otlp"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "SharePoint": {
    "TenantId": "REPLACE_WITH_ENTRA_TENANT_ID",
    "ClientId": "REPLACE_WITH_ENTRA_APPLICATION_CLIENT_ID",
    "ClientSecret": "REPLACE_WITH_ENTRA_APPLICATION_CLIENT_SECRET",
    "SiteHostname": "REPLACE_WITH_TENANT.sharepoint.com",
    "SitePath": "/sites/REPLACE_WITH_SITE_NAME",
    "DocumentLibraryName": "Documents",
    "SubscriptionRenewalEnabled": true,
    "NotificationUrl": "https://REPLACE_WITH_PUBLIC_HOST/api/sharepoint/webhook",
    "ClientState": "REPLACE_WITH_THE_SAME_LONG_RANDOM_SECRET",
    "SubscriptionLifetimeDays": 28,
    "RenewalCheckHours": 12
  },
  "ServiceBus": {
    "Enabled": true,
    "UsedManagedIdentity": false,
    "FullyQualifiedNamespace": "REPLACE_WITH_NAMESPACE.servicebus.windows.net",
    "ConnectionString": null,
    "TopicName": "sharepoint-changes",
    "SubscriptionName": "search-indexer"
  },
  "SqlServer": {
    "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=SharePointSearch;Integrated Security=true;TrustServerCertificate=true",
    "AutoMigrate": true,
    "CommandTimeoutSeconds": 30
  },
  "AzureSearch": {
    "UsedManagedIdentity": false,
    "Endpoint": "https://REPLACE_WITH_SEARCH.search.windows.net",
    "ApiKey": null,
    "SharePointIndexName": "sharepoint-files",
    "VectorDimensions": 1536
  },
  "AzureOpenAI": {
    "UsedManagedIdentity": false,
    "Endpoint": "https://REPLACE_WITH_OPENAI.openai.azure.com",
    "EmbeddingDeployment": "text-embedding-3-small",
    "ApiKey": null
  },
  "DocumentIntelligence": {
    "UsedManagedIdentity": false,
    "Endpoint": null,
    "ModelId": "prebuilt-read",
    "ApiVersion": "2024-11-30",
    "ApiKey": null
  },
  "MarkItDown": {
    "Endpoint": "http://localhost:8000",
    "ConvertPath": "/convert",
    "HealthPath": "/health",
    "TimeoutSeconds": 120,
    "HealthCheckEnabled": true,
    "HealthCheckMinutes": 5
  },
  "PageIndex": {
    "Endpoint": "http://localhost:8001",
    "ApiKey": null,
    "IndexPath": "/index",
    "HealthPath": "/health",
    "TimeoutSeconds": 360
  },
  "Ollaya": {
    "Endpoint": "",
    "ApiKey": null,
    "Model": "winnow:e4b",
    "DecidePath": "/v1/systemone",
    "HealthPath": "/",
    "TimeoutSeconds": 300
  },
  "Processor": {
    "MaxFileBytes": 20971520,
    "ChunkSizeCharacters": 4000,
    "ChunkOverlapCharacters": 400,
    "SyncOnStartup": true,
    "ChangeSignalListenerEnabled": true,
    "ScheduledSyncEnabled": true,
    "ScheduledSyncMinutes": 5,
    "AllowedFileExtensions": [ ".pdf", ".docx", ".pptx", ".xlsx", ".txt", ".md" ]
  },
  "GraphRag": {
    "IndexingEnabled": false,
    "RetrievalEnabled": false,
    "ShadowRetrieval": false,
    "EnabledTenantIds": [],
    "IndexingQueueName": "graph-indexing",
    "AliasIndexName": "graph-entity-aliases",
    "Extraction": {
      "Deployment": "",
      "IncludeEncryptedDocuments": false,
      "MaxConcurrentDocuments": 2,
      "MaxConcurrentChunks": 4,
      "MaxChunksPerDocument": 200,
      "MaxOutputTokens": 2000,
      "NeighborContextCharacters": 600,
      "MaxRetries": 4,
      "MaxDeliveryAttempts": 8
    },
    "Traversal": {
      "DefaultMaxDepth": 2,
      "MaxEntities": 50,
      "MaxAssertions": 200,
      "MaxSeedEntities": 10,
      "TimeoutMilliseconds": 1500,
      "MaxRequestCharge": 500,
      "MaxAdditionalChunks": 5,
      "MaxAdditionalCharacters": 12000,
      "MaxEvidenceDocuments": 40
    },
    "Reconciliation": {
      "Enabled": true,
      "IntervalMinutes": 60,
      "PageSize": 200,
      "MaxRepairsPerCycle": 500,
      "RetractedRetentionDays": 30
    },
    "Cosmos": {
      "UsedManagedIdentity": true,
      "Endpoint": "",
      "DatabaseName": "graphrag",
      "PartitionBuckets": 16,
      "CreateIfNotExists": false
    },
    "Archive": {
      "UsedManagedIdentity": true,
      "ServiceUri": "",
      "ContainerName": "graph-snapshots"
    }
  }
}
